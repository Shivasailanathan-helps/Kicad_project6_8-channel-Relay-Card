	)
	(text "NOTE: POWER SUPPLY LABEL (VCC)\n\nWe use 'VCC' instead of a fixed voltage (like +5V or +12V)\nbecause this relay module is a modular design.\nThe exact same schematic and PCB layout \nwork with 5V, 12V, or 24V relays. \n'VCC' represents the generic main positive \npower rail for whichever supply voltage is connected to J1/J2."
		(exclude_from_sim no)
		(at 81.534 107.188 0)
		(effects
			(font
				(size 1.27 1.27)
			)
